# Runtime data — live session state (headlines, task descriptions, project and
# file paths, "where it left off" summaries) from every session across every
# project. May contain proprietary/client info. NEVER commit this.
/data/

# Dependencies
node_modules/

# Playwright / browser artifacts (created during local UI testing)
.playwright-mcp/
playwright-profile/

# Local Claude Code settings — may contain session ids and absolute paths.
# (Also covered by many users' global ignore; pinned here so this repo does not
# depend on a machine-level config for that.)
.claude/settings.local.json

# Ad-hoc screenshots — these capture the live board, which shows real project
# names and session text. Only the curated ones under docs/ are committed.
*.png
*.jpg
*.jpeg
!docs/*.png
!docs/*.jpg
!docs/*.jpeg
